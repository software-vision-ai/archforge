<!-- The Windows installer: per-user or per-machine with a wizard. The namespace marker is
     filled by package.ps1 from WIX_NAMESPACE. Variables: Version, BinDir, IconFile, RootDir. -->
<Wix xmlns="__WIX_NAMESPACE__/wxs" xmlns:ui="__WIX_NAMESPACE__/wxs/ui">
  <Package Name="!(loc.ProductName)" Manufacturer="!(loc.Manufacturer)" Version="$(var.Version)"
           UpgradeCode="FF039653-6730-967C-EE7A-F98C442841DF" Scope="perUserOrMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="!(loc.Downgrade)" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="archforge.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="archforge.ico" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RootDir)\packaging\windows\license.rtf" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="!(loc.ProductName)">
        <Component Id="MainExecutable">
          <File Id="AppExe" Source="$(var.BinDir)\archforge.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="!(loc.ProductName)" Icon="archforge.ico" Advertise="yes" />
          </File>
        </Component>
        <!-- One file to a component: WiX gives a component its GUID itself only when it holds one. -->
        <Component Id="CLicenseMit">
          <File Id="LicenseMit" Source="$(var.RootDir)\LICENSE-MIT" KeyPath="yes" />
        </Component>
        <Component Id="CLicenseApache">
          <File Id="LicenseApache" Source="$(var.RootDir)\LICENSE-APACHE" KeyPath="yes" />
        </Component>
        <Component Id="CNotice">
          <File Id="Notice" Source="$(var.RootDir)\NOTICE" KeyPath="yes" />
        </Component>
        <Component Id="CAttribution">
          <File Id="Attribution" Source="$(var.RootDir)\ATTRIBUTION.md" KeyPath="yes" />
        </Component>
        <Directory Id="LicensesFolder" Name="licenses">
          <Directory Id="FontLicensesFolder" Name="fonts">
            <!-- The texts of the fonts the program embeds; package.ps1 checks that every file under
                 licenses/ is listed here. -->
            <Component Id="CFontLicenceHack">
              <File Id="FontLicenceHack" Source="$(var.RootDir)\licenses\fonts\Hack.txt" KeyPath="yes" />
            </Component>
            <Component Id="CFontLicenceOfl">
              <File Id="FontLicenceOfl" Source="$(var.RootDir)\licenses\fonts\OFL-1.1.txt" KeyPath="yes" />
            </Component>
            <Component Id="CFontLicenceInter">
              <File Id="FontLicenceInter" Source="$(var.RootDir)\licenses\fonts\Inter-OFL.txt" KeyPath="yes" />
            </Component>
            <Component Id="CFontLicenceUbuntu">
              <File Id="FontLicenceUbuntu" Source="$(var.RootDir)\licenses\fonts\Ubuntu-font-1.0.txt" KeyPath="yes" />
            </Component>
            <Component Id="CFontLicenceEmojiIcon">
              <File Id="FontLicenceEmojiIcon" Source="$(var.RootDir)\licenses\fonts\emoji-icon-font-MIT.txt" KeyPath="yes" />
            </Component>
          </Directory>
          <Directory Id="BrandLicensesFolder" Name="brand">
            <!-- The terms of the application icon, a brand mark. -->
            <Component Id="BrandLicences">
              <File Id="BrandLicenceIcon" Source="$(var.RootDir)\licenses\brand\archforge-icon.txt" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="!(loc.ProductName)">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="CLicenseMit" />
      <ComponentRef Id="CLicenseApache" />
      <ComponentRef Id="CNotice" />
      <ComponentRef Id="CAttribution" />
      <ComponentRef Id="CFontLicenceHack" />
      <ComponentRef Id="CFontLicenceOfl" />
      <ComponentRef Id="CFontLicenceInter" />
      <ComponentRef Id="CFontLicenceUbuntu" />
      <ComponentRef Id="CFontLicenceEmojiIcon" />
      <ComponentRef Id="BrandLicences" />
    </Feature>
  </Package>
</Wix>
