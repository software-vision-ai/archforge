<?xml version="1.0" encoding="UTF-8"?>
<!-- The shared core metamodel of Archforge (decision gm2.20): what every notation has in common.
     Everything that refers to another notation's element is typed Any, so the core depends on no
     notation. Generated into crates/core/src/generated by `cargo xtask generate core`. -->
<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
  <uml:Package xmi:type="uml:Package" xmi:id="_0" name="core" URI="archforge:core">
    <packagedElement xmi:type="uml:Enumeration" xmi:id="LinkKind" name="LinkKind">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LinkKind-trace" name="trace"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LinkKind-realization" name="realization"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LinkKind-persistence" name="persistence"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LinkKind-derivation" name="derivation"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LinkKind-satisfaction" name="satisfaction"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LinkKind-refinement" name="refinement"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Element" name="Element" isAbstract="true">
      <ownedAttribute xmi:type="uml:Property" xmi:id="Element-ownedElement" name="ownedElement" isReadOnly="true" isDerived="true" isDerivedUnion="true" aggregation="composite">
        <type href="archforge:mof#Any"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Element-ownedElement-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Element-ownedElement-_upperValue" value="*"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Element-ownedComment" name="ownedComment" type="Comment" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Element-ownedComment-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Element-ownedComment-_upperValue" value="*"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="NamedElement" name="NamedElement" isAbstract="true">
      <generalization xmi:type="uml:Generalization" xmi:id="NamedElement-_generalization" general="Element"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="NamedElement-name" name="name">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="NamedElement-name-_lowerValue"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Model" name="Model">
      <generalization xmi:type="uml:Generalization" xmi:id="Model-_generalization" general="NamedElement"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Model-member" name="member" isOrdered="true" aggregation="composite" subsettedProperty="Element-ownedElement">
        <type href="archforge:mof#Any"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Model-member-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Model-member-_upperValue" value="*"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Model-comment" name="comment" type="Comment" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Model-comment-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Model-comment-_upperValue" value="*"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Model-tag" name="tag" type="Tag" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Model-tag-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Model-tag-_upperValue" value="*"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Model-link" name="link" type="Link" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Model-link-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Model-link-_upperValue" value="*"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Folder" name="Folder">
      <generalization xmi:type="uml:Generalization" xmi:id="Folder-_generalization" general="NamedElement"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Folder-member" name="member" isOrdered="true" aggregation="composite" subsettedProperty="Element-ownedElement">
        <type href="archforge:mof#Any"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Folder-member-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Folder-member-_upperValue" value="*"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Folder-tag" name="tag" type="Tag" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Folder-tag-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Folder-tag-_upperValue" value="*"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Comment" name="Comment">
      <generalization xmi:type="uml:Generalization" xmi:id="Comment-_generalization" general="Element"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Comment-body" name="body">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Comment-body-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Comment-annotatedElement" name="annotatedElement">
        <type href="archforge:mof#Any"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Comment-annotatedElement-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Comment-annotatedElement-_upperValue" value="*"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Tag" name="Tag">
      <generalization xmi:type="uml:Generalization" xmi:id="Tag-_generalization" general="Element"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Tag-name" name="name">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Tag-value" name="value">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Tag-value-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Tag-element" name="element">
        <type href="archforge:mof#Any"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Tag-element-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Tag-element-_upperValue" value="*"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Link" name="Link">
      <generalization xmi:type="uml:Generalization" xmi:id="Link-_generalization" general="Element"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Link-kind" name="kind" type="LinkKind">
        <defaultValue xmi:type="uml:InstanceValue" xmi:id="Link-kind-_defaultValue" type="LinkKind" instance="LinkKind-trace"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Link-source" name="source">
        <type href="archforge:mof#Any"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Link-target" name="target">
        <type href="archforge:mof#Any"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Link-note" name="note">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Link-note-_lowerValue"/>
      </ownedAttribute>
    </packagedElement>
  </uml:Package>
</xmi:XMI>
