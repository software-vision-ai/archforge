      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="ReferentialAction-cascade" name="cascade"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="ReferentialAction-setNull" name="setNull"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="ReferentialAction-setDefault" name="setDefault"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Enumeration" xmi:id="MatchType" name="MatchType">
