      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Deferrability-initiallyDeferred" name="initiallyDeferred"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Enumeration" xmi:id="Generation" name="Generation">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Generation-none" name="none"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Generation-identityAlways" name="identityAlways"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Generation-identityByDefault" name="identityByDefault"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Generation-computedStored" name="computedStored"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Generation-computedVirtual" name="computedVirtual"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Enumeration" xmi:id="SortDirection" name="SortDirection">
