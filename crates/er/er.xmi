<?xml version="1.0" encoding="UTF-8"?>
<!-- The ER notation's metamodel (decision gm2.20): a schema of entities with ordered attributes and
     relationships with a cardinality at each end; primary keys and unique constraints as named
     key elements with their own column order; foreign keys onto any key, with their own columns
     matched to the key's by position, referential actions, match type and deferrability; mapping
     tables as entities of kind associative; relationships with a role at each end. Generated into
     crates/er/src/generated by `cargo xtask generate er`. Comments on ER elements come from the shared
     core. -->
<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
  <uml:Package xmi:type="uml:Package" xmi:id="_0" name="er" URI="archforge:er">
    <packagedElement xmi:type="uml:Enumeration" xmi:id="Cardinality" name="Cardinality">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Cardinality-zeroOrOne" name="zeroOrOne"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Cardinality-exactlyOne" name="exactlyOne"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Cardinality-zeroOrMore" name="zeroOrMore"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Cardinality-oneOrMore" name="oneOrMore"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Enumeration" xmi:id="EntityKind" name="EntityKind">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EntityKind-regular" name="regular"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EntityKind-associative" name="associative"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Enumeration" xmi:id="ReferentialAction" name="ReferentialAction">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="ReferentialAction-noAction" name="noAction"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="ReferentialAction-restrict" name="restrict"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="ReferentialAction-cascade" name="cascade"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="ReferentialAction-setNull" name="setNull"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="ReferentialAction-setDefault" name="setDefault"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Enumeration" xmi:id="MatchType" name="MatchType">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="MatchType-simple" name="simple"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="MatchType-full" name="full"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="MatchType-partial" name="partial"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Enumeration" xmi:id="Deferrability" name="Deferrability">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Deferrability-notDeferrable" name="notDeferrable"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Deferrability-initiallyImmediate" name="initiallyImmediate"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="Deferrability-initiallyDeferred" name="initiallyDeferred"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Element" name="Element" isAbstract="true">
      <ownedAttribute xmi:type="uml:Property" xmi:id="Element-ownedElement" name="ownedElement" isReadOnly="true" isDerived="true" isDerivedUnion="true" aggregation="composite">
        <type href="archforge:mof#Any"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Element-ownedElement-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Element-ownedElement-_upperValue" value="*"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="NamedElement" name="NamedElement" isAbstract="true">
      <generalization xmi:type="uml:Generalization" xmi:id="NamedElement-_generalization" general="Element"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="NamedElement-name" name="name">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Schema" name="Schema">
      <generalization xmi:type="uml:Generalization" xmi:id="Schema-_generalization" general="NamedElement"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Schema-entity" name="entity" type="Entity" isOrdered="true" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Schema-entity-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Schema-entity-_upperValue" value="*"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Schema-relationship" name="relationship" type="Relationship" isOrdered="true" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Schema-relationship-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Schema-relationship-_upperValue" value="*"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Entity" name="Entity">
      <generalization xmi:type="uml:Generalization" xmi:id="Entity-_generalization" general="NamedElement"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Entity-attribute" name="attribute" type="Attribute" isOrdered="true" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Entity-attribute-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Entity-attribute-_upperValue" value="*"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Entity-kind" name="kind" type="EntityKind">
        <defaultValue xmi:type="uml:InstanceValue" xmi:id="Entity-kind-_defaultValue" type="EntityKind" instance="EntityKind-regular"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Entity-primaryKey" name="primaryKey" type="PrimaryKey" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Entity-primaryKey-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Entity-uniqueConstraint" name="uniqueConstraint" type="UniqueConstraint" isOrdered="true" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Entity-uniqueConstraint-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Entity-uniqueConstraint-_upperValue" value="*"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Entity-foreignKey" name="foreignKey" type="ForeignKey" isOrdered="true" aggregation="composite" subsettedProperty="Element-ownedElement">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Entity-foreignKey-_lowerValue"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Entity-foreignKey-_upperValue" value="*"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Attribute" name="Attribute">
      <generalization xmi:type="uml:Generalization" xmi:id="Attribute-_generalization" general="NamedElement"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Attribute-type" name="type">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Attribute-type-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Attribute-nullable" name="nullable">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>
        <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="Attribute-nullable-_defaultValue" value="true"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Relationship" name="Relationship">
      <generalization xmi:type="uml:Generalization" xmi:id="Relationship-_generalization" general="Element"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Relationship-name" name="name">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Relationship-name-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Relationship-from" name="from" type="Entity"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Relationship-to" name="to" type="Entity"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Relationship-fromEnd" name="fromEnd" type="Cardinality">
        <defaultValue xmi:type="uml:InstanceValue" xmi:id="Relationship-fromEnd-_defaultValue" type="Cardinality" instance="Cardinality-exactlyOne"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Relationship-toEnd" name="toEnd" type="Cardinality">
        <defaultValue xmi:type="uml:InstanceValue" xmi:id="Relationship-toEnd-_defaultValue" type="Cardinality" instance="Cardinality-zeroOrMore"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Relationship-fromRole" name="fromRole">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Relationship-fromRole-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Relationship-toRole" name="toRole">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Relationship-toRole-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Relationship-identifying" name="identifying">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>
        <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="Relationship-identifying-_defaultValue" value="false"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="Key" name="Key" isAbstract="true">
      <generalization xmi:type="uml:Generalization" xmi:id="Key-_generalization" general="Element"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Key-name" name="name">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Key-name-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="Key-column" name="column" type="Attribute" isOrdered="true">
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Key-column-_upperValue" value="*"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="PrimaryKey" name="PrimaryKey">
      <generalization xmi:type="uml:Generalization" xmi:id="PrimaryKey-_generalization" general="Key"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="UniqueConstraint" name="UniqueConstraint">
      <generalization xmi:type="uml:Generalization" xmi:id="UniqueConstraint-_generalization" general="Key"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="UniqueConstraint-nullsDistinct" name="nullsDistinct">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>
        <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="UniqueConstraint-nullsDistinct-_defaultValue" value="true"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="ForeignKey" name="ForeignKey">
      <generalization xmi:type="uml:Generalization" xmi:id="ForeignKey-_generalization" general="Element"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="ForeignKey-name" name="name">
        <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="ForeignKey-name-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="ForeignKey-references" name="references" type="Key"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="ForeignKey-column" name="column" type="Attribute" isOrdered="true">
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="ForeignKey-column-_upperValue" value="*"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="ForeignKey-onDelete" name="onDelete" type="ReferentialAction">
        <defaultValue xmi:type="uml:InstanceValue" xmi:id="ForeignKey-onDelete-_defaultValue" type="ReferentialAction" instance="ReferentialAction-noAction"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="ForeignKey-onUpdate" name="onUpdate" type="ReferentialAction">
        <defaultValue xmi:type="uml:InstanceValue" xmi:id="ForeignKey-onUpdate-_defaultValue" type="ReferentialAction" instance="ReferentialAction-noAction"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="ForeignKey-relationship" name="relationship" type="Relationship">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="ForeignKey-relationship-_lowerValue"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="ForeignKey-match" name="match" type="MatchType">
        <defaultValue xmi:type="uml:InstanceValue" xmi:id="ForeignKey-match-_defaultValue" type="MatchType" instance="MatchType-simple"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="ForeignKey-deferrable" name="deferrable" type="Deferrability">
        <defaultValue xmi:type="uml:InstanceValue" xmi:id="ForeignKey-deferrable-_defaultValue" type="Deferrability" instance="Deferrability-notDeferrable"/>
      </ownedAttribute>
    </packagedElement>
  </uml:Package>
</xmi:XMI>
