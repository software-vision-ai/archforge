<?xml version="1.0" encoding="UTF-8"?>
<!-- The ER notation's metamodel (decision gm2.20): a schema of entities with ordered attributes and
     relationships with a cardinality at each end; primary keys and unique constraints as named
     key elements with their own column order; foreign keys onto any key, with their own columns
     matched to the key's by position, referential actions, match type and deferrability; check
     constraints and indexes (TableIndex, since Index would clash with the generated package index)
     with ordered index columns; mapping tables as entities of kind associative; relationships with
     a role at each end. Generated into
     crates/er/src/generated by `cargo xtask generate er`. Comments on ER elements come from the shared
     core. -->
<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
  <uml:Package xmi:type="uml:Package" xmi:id="_0" name="er" URI="archforge:er">
